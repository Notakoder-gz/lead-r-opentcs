# ==========================================
# Network & General Settings
# ==========================================
# Host IP address used for OpenTCS Java RMI and RMF Dashboard server URL
HOST_IP=192.168.3.142

# ROS2 Domain ID (Used across multiple containers)
ROS_DOMAIN_ID=20

# ROS2 Discovery Server (if applicable)
ROS_DISCOVERY_SERVER=127.0.0.1:11811

# ==========================================
# OpenTCS Paths
# ==========================================
# Absolute or relative paths to OpenTCS configs
OPENTCS_CONFIG_DIR=./opentcs/config
OPENTCS_DATA_DIR=./opentcs/data

# ==========================================
# Open-RMF Paths
# ==========================================
# Path to API Server Config
RMF_API_CONFIG_FILE=./rmf_api_config/my_config.py

# Path to deploy maps for API server and Building Map Server
RMF_MAPS_DIR=./deploy_maps

# ==========================================
# Fleet Adapters Paths
# ==========================================
# Yahboom Fleet Adapter
YAHBOOM_ADAPTER_FILE=./rmf_bridge/yahboom_adapter.py
YAHBOOM_MAP_FILE=./rmf_compile_map/L1.nav/0.yaml

# OpenTCS Fleet Adapter
OPENTCS_ADAPTER_FILE=./fleet_config/adapter.py
OPENTCS_ADAPTER_CONFIG_FILE=./fleet_config/fleet_config.yaml
